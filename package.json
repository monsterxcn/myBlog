{
  "name": "myblog",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "build": "node --openssl-legacy-provider ./node_modules/gridsome/bin/gridsome.js build",
    "develop": "node --openssl-legacy-provider ./node_modules/gridsome/bin/gridsome.js develop",
    "explore": "node --openssl-legacy-provider ./node_modules/gridsome/bin/gridsome.js explore",
